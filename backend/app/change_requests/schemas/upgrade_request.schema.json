{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "type": "string"
    },
    "dna_version": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    },
    "kind": {
      "enum": [
        "UPGRADE"
      ],
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "requested_autonomy_level": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ],
      "type": "string"
    },
    "requester": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "resident",
            "human"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "schema_version": {
      "enum": [
        "1.0.0"
      ],
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "ed25519"
          ],
          "type": "string"
        },
        "public_key_id": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "public_key_id",
        "value"
      ],
      "type": "object"
    },
    "upgrade": {
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "component_kind": {
          "enum": [
            "block",
            "kit",
            "dna_surface"
          ],
          "type": "string"
        },
        "from_version": {
          "type": "string"
        },
        "to_version": {
          "type": "string"
        }
      },
      "required": [
        "component",
        "from_version",
        "to_version"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "kind",
    "product_id",
    "dna_version",
    "requester",
    "evidence",
    "requested_autonomy_level",
    "created_at",
    "signature",
    "upgrade"
  ],
  "title": "UPGRADE",
  "type": "object"
}
