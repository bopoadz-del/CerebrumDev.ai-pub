{
  "schema": "secret_patterns.v1",
  "note": "Redaction data for app/factory/build/sanitize.py. Every pattern here is used ONLY to substitute [redacted] into text; nothing branches on a match. Edit this file to add a provider key format; sanitize.py loads it at runtime and fails closed (redacts more) if it cannot.",
  "header_line": "(?im)^\\s*(?:authorization|proxy-authorization|x-api-key|api-key|cookie|set-cookie)\\s*:\\s*.*$",
  "key_assignment": "(?i)(?<![A-Za-z0-9])(?:api[_-]?key|apikey|secret|password|passwd|access[_-]?key|private[_-]?key)\\s*[=:]\\s*(\\S+)",
  "provider_keys": [
    "\\b(?:sk|rk|pk)-[A-Za-z0-9_-]{16,}\\b",
    "\\bAKIA[0-9A-Z]{16}\\b",
    "\\bgh[pousr]_[A-Za-z0-9]{20,}\\b",
    "\\bxox[baprs]-[A-Za-z0-9-]{20,}\\b"
  ],
  "long_blob": "(?<![A-Za-z0-9+/_=-])(?:[A-Za-z0-9+/_=-]*[A-Z+=][A-Za-z0-9+/_=-]*|[a-z0-9]+)(?![A-Za-z0-9+/_=-])(?<=[A-Za-z0-9+/_=-]{40})",
  "token": "(?<![A-Za-z0-9+/_=-])[A-Za-z0-9+/_=-]+(?![A-Za-z0-9+/_=-])",
  "entropy": {
    "min_length": 24,
    "bits_per_char": 4.2
  }
}
